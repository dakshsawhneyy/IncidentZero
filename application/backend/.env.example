# ── Database ────────────────────────────────────────────────
# OLD: Azure Managed Postgres (deprecated)
# DATABASE_URL=postgresql://incidentadmin:YourPassword@incidentzero-postgres.postgres.database.azure.com:5432/incidentdb
# DB_SSL=true

# NEW: Neon Postgres (free tier)
# 1. Create a project at https://neon.tech
# 2. Go to Dashboard → Connection Details → copy the connection string
# 3. Paste it below (it already includes ?sslmode=require)
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# SSL must stay true for Neon
DB_SSL=true

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────
# Set this to your Render frontend URL once deployed
# e.g. https://incidentzero-frontend.onrender.com
CORS_ORIGIN=https://<your-frontend>.onrender.com
